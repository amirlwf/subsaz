# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# pyinstaller
build/
dist/
release/
*.spec.bak

# frontend (TypeScript + vite) — web_dist/ IS committed so the app runs
# without node; only the dependency tree is local
web/node_modules/
web/.vite/

# SpecKit / AI agent workspace — local only, never committed
.specify/
.opencode/
specs/
claude/
CLAUDE.local.md

# personal notes — local only, never committed
PERSONAL.md
MYNOTES.md
*.local.md

# local runs
*_started.log
subsaz_tmp/
*.wav
*.srt

# local-only exports / scratch (ForHermes holds credentials — never commit)
ForHermes/
assets/_preview_ico.png

# maintainer-only docs (release guides, personal checklists) — never committed
docs/

# sample media (do not commit large binaries)
*.mp4
*.mkv
*.mov
*.webm
*.mp3
*.wav

# portable ffmpeg is added at build time, never committed (~200MB)
assets/bin/*.exe

# models are downloaded at runtime, never committed
models/
